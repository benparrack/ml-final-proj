





import pandas as pd
import matplotlib.pyplot as plt

ad = pd.read_csv("../data/Ad_table (extra).csv", low_memory=False)
price = pd.read_csv("../data/Price_table.csv")
ad.columns = ad.columns.str.strip()  # some column names in this file start with a space

print("ad table:", ad.shape)
print("price table:", price.shape)
print("car models in ads:", ad["Genmodel_ID"].nunique(), "| with a new price:", price["Genmodel_ID"].nunique())
ad.head()





ad.dtypes








print("% Percent of missing values")
(ad.isna().mean() * 100).round(1).sort_values(ascending=False)





print("Total missing values: ", ad.isna().sum().sum())
print("Total rows with missing values: ", ad.isna().any(axis=1).sum())





print("same Adv_ID twice:", ad["Adv_ID"].duplicated().sum())
print("same car listed twice (every column equal except Adv_ID):", ad.drop(columns="Adv_ID").duplicated().sum())








ad["Adv_year"].value_counts().sort_index()








print(ad["Price"].describe())
print(ad["Price"].nlargest(5))
ad[ad["Price"] < 300][["Maker", "Genmodel", "Reg_year", "Runned_Miles", "Price"]].sample(8, random_state=1)








ad = ad.drop_duplicates(subset=ad.columns.drop("Adv_ID"))
ad = ad.dropna(subset=["Price"])
ad = ad[~ad["Price"].isin([999999, 9999999])]

df = ad.merge(price[["Genmodel_ID", "Year", "Entry_price"]], left_on=["Genmodel_ID", "Reg_year"], right_on=["Genmodel_ID", "Year"])
print("ads matched to a new price:", round(len(df) / len(ad) * 100, 1), "%")

df["age"] = df["Adv_year"] - df["Reg_year"]
print("negative ages dropped:", (df["age"] < 0).sum())
df = df[df["age"] >= 0]
df["retention"] = df["Price"] / df["Entry_price"]

print("usable ads:", len(df), "| car models:", df["Genmodel_ID"].nunique())








df["retention"].describe()


df["retention"].hist(bins=100, range=(0, 2), color="#40E0C0")
plt.xlabel("retention ratio (used price / new entry price)")
plt.ylabel("number of ads")
plt.title("Distribution of value retention")
plt.show()





df.to_csv("../data/cars_joined.csv", index=False)
